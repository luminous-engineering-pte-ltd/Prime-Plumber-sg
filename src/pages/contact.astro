---
import Layout from '../layouts/Layout.astro'; import QuoteForm from '../components/QuoteForm.astro'; import FAQ from '../components/FAQ.astro'; import { faqs } from '../data/services'; import { Phone,MessageCircle,Mail,MapPin,Clock3 } from 'lucide-astro';
---
<Layout title="Contact a Plumber in Singapore | PrimeFlow" description="Call, WhatsApp or request a plumbing quote from PrimeFlow. 24/7 emergency support and islandwide service across Singapore.">
<section class="hero"><div class="container"><span class="eyebrow">Contact PrimeFlow</span><h1>Tell us what<br/>needs fixing.</h1><p>Share the symptoms, property type and any useful photos. We’ll help you understand the next step.</p></div></section>
<section class="contact-main"><div class="container contact-grid"><div class="cards"><a href="tel:+6568174420"><Phone/><div><small>Call 24/7</small><b>+65 6817 4420</b><span>For urgent leaks and chokes</span></div></a><a target="_blank" rel="noopener" href="https://wa.me/6568174420"><MessageCircle/><div><small>WhatsApp</small><b>Send photos or a message</b><span>Opens in a new tab</span></div></a><a href="mailto:hello@primeplumbing.sg"><Mail/><div><small>Email</small><b>hello@primeplumbing.sg</b><span>For planned work and enquiries</span></div></a><div><MapPin/><div><small>Coverage</small><b>Islandwide Singapore</b><span>HDB · Condo · Landed · Commercial</span></div></div><div class="emergency"><Clock3/><div><small>Emergency support</small><b>Available 24 hours, 7 days</b><span>We provide a realistic arrival estimate when you call.</span></div></div></div><div class="form card"><h2>Request a free quote.</h2><p>Required fields help us route your request to the right person.</p><QuoteForm /></div></div></section>
<section class="section faq"><div class="container faq-grid"><div><span class="eyebrow">Before you book</span><h2>Common questions.</h2><p class="lead">For an active leak or severe choke, call rather than waiting for a form response.</p></div><FAQ faqs={faqs.slice(0,5)}/></div></section>
<section class="emergency-cta"><img src="/images/hero-plumber.png" alt="PrimeFlow emergency plumber in Singapore" loading="lazy"/><div></div><article><span>Available 24/7 across Singapore</span><h2>Urgent plumbing problem?</h2><p>Protect the area if it is safe to do so, shut off the nearest water supply and call our emergency line.</p><a class="btn btn-primary" href="tel:+6568174420"><Phone size={17}/> Call +65 6817 4420</a></article></section>
</Layout>
<style>.hero{padding:175px 0 150px;background:#061a35;color:white}.hero h1{font-size:clamp(3.7rem,7vw,6.5rem)}.hero p{color:#b6c5d5;max-width:650px;line-height:1.7}.contact-main{margin-top:-70px;padding-bottom:100px;position:relative}.contact-grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:20px}.cards{display:grid;gap:11px}.cards>a,.cards>div{background:white;border:1px solid #dce5ee;border-radius:14px;padding:20px;display:flex;gap:14px;box-shadow:0 12px 30px #0b274615}.cards>a>svg,.cards>div>svg{width:42px;height:42px;padding:11px;border-radius:10px;background:#eaf4ff;color:#1877f2}.cards small,.cards b,.cards span{display:block}.cards small{color:#1877f2;text-transform:uppercase;font-weight:800;font-size:.62rem}.cards b{margin:4px 0}.cards span{font-size:.72rem;color:#768598}.cards .emergency{background:#1877f2;color:white}.cards .emergency small,.cards .emergency span{color:#dbeaff}.cards .emergency>svg{background:#ffffff25;color:white}.form{padding:35px}.form>p{color:#728197}.faq{background:#f5f7f9}.faq-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:60px}.emergency-cta{min-height:520px;position:relative;color:white;display:grid;place-items:center;text-align:center;overflow:hidden}.emergency-cta>img,.emergency-cta>div{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.emergency-cta>div{background:#051a37c9}.emergency-cta article{position:relative;max-width:700px;padding:30px}.emergency-cta span{text-transform:uppercase;font-size:.7rem;letter-spacing:.1em;font-weight:800;color:#6eb3ff}.emergency-cta h2{margin:15px 0}.emergency-cta p{color:#c9d5e2;line-height:1.7}@media(max-width:800px){.contact-grid,.faq-grid{grid-template-columns:1fr}.contact-main{margin-top:-90px}.form{padding:24px}}</style>
