---
import { services } from '../data/services';
const { compact=false }=Astro.props;
---
<form class:list={['quote-form',compact&&'compact']} action="/contact?sent=true" method="get">
  <label>Full Name<input name="name" autocomplete="name" required placeholder="Your name" /></label>
  {!compact && <label>Email Address<input type="email" name="email" autocomplete="email" required placeholder="you@email.com" /></label>}
  <label>Phone Number<input type="tel" name="phone" autocomplete="tel" required pattern="[0-9 +()-]{8,}" placeholder="+65 8123 4567" /></label>
  {!compact && <label>Property Type<select name="property" required><option value="">Select property</option><option>HDB</option><option>Condo</option><option>Landed</option><option>Commercial</option><option>Other</option></select></label>}
  <label>Service Required<select name="service" required><option value="">Select service</option>{services.map(s=><option>{s.title}</option>)}</select></label>
  {!compact && <label>Preferred Date<input type="date" name="date" /></label>}
  {!compact && <label class="message">Message<textarea name="message" rows="4" placeholder="Tell us what is happening"></textarea></label>}
  <button class="btn btn-primary" type="submit">{compact?'Request a Call':'Get a Free Quote'} <span>→</span></button>
</form>
<style>.quote-form{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}.quote-form label{font-size:.73rem;font-weight:500;color:#42526a}.quote-form input,.quote-form select,.quote-form textarea{display:block;width:100%;margin-top:7px;border:1px solid #dce5ef;border-radius:10px;padding:13px;background:#f8fafc;color:#0b1830;outline:none}.quote-form input:focus,.quote-form select:focus,.quote-form textarea:focus{border-color:#2084f8;box-shadow:0 0 0 3px #1883ff20}.message{grid-column:1/-1}.quote-form>.btn{align-self:end}.compact{grid-template-columns:1fr 1fr 1fr 180px;align-items:end}.compact label{color:#263750}.compact .btn{width:100%}@media(max-width:900px){.compact{grid-template-columns:1fr 1fr}.quote-form{grid-template-columns:1fr}.message{grid-column:auto}}@media(max-width:500px){.compact{grid-template-columns:1fr}}</style>
