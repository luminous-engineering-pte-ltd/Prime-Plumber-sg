---
import Layout from '../../layouts/Layout.astro'; import FAQ from '../../components/FAQ.astro'; import ServiceCard from '../../components/ServiceCard.astro'; import { services,slugify } from '../../data/services'; import * as icons from 'lucide-astro'; import { Phone,MessageCircle,CheckCircle2,MapPin,Clock3,BadgeDollarSign,Award,ShieldCheck,MapPinned,ArrowUpRight } from 'lucide-astro';
export function getStaticPaths(){return services.map(service=>({params:{service:service.slug},props:{service}}))}
const {service}=Astro.props; const related=services.filter(s=>s.slug!==service.slug).slice(0,3); const localFaqs=service.faqs;
const ServiceIcon=icons[service.icon] || icons.Wrench;
const reasons=[[Award,'Experienced Plumbers','Skilled professionals who assess the system before recommending work.'],[Clock3,'Fast Response','Realistic arrival estimates and clear updates for urgent and planned jobs.'],[BadgeDollarSign,'Transparent Pricing','The scope and price are explained for approval before work begins.'],[ShieldCheck,'Quality Workmanship','Careful installation, tidy finishing and functional checks at handover.'],[MapPinned,'Islandwide Service','Coverage across Central, East, West, North, North-East and South Singapore.']];
const schema={'@context':'https://schema.org','@type':'Service',name:`${service.title} Singapore`,description:service.description,provider:{'@type':'Plumber',name:'PrimeFlow Plumbing'},areaServed:'Singapore'};
---
<Layout title={service.seo.title} description={service.seo.description} schema={schema}>
<section class="service-hero"><div class="container"><nav aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/services">Services</a><span>/</span><b>{service.title}</b></nav><div class="hero-grid"><div><span class="eyebrow">Specialist plumbing service</span><h1>{service.title}<br/><em>Singapore</em></h1><p>{service.description}</p><div class="actions"><a class="btn btn-primary" href="/contact">Get a Quote</a><a class="btn btn-light" href="tel:+6568174420"><Phone size={17}/> Call Now</a></div></div><img src={service.image} alt={`${service.title} by a professional plumber in Singapore`} /></div></div></section>
<section class="section overview"><div class="container intro-grid"><div><span class="eyebrow">Service overview</span><h2>Understand the problem. Choose the right fix.</h2><p class="lead">{service.description} A good result begins with identifying the actual cause, not simply treating the most visible symptom.</p><div class="overview-points"><article><h3>What the service covers</h3><p>Inspection, clear recommendations and professional repair or installation using materials suited to the property.</p></article><article><h3>Common problems</h3><p>Leaks, poor flow, recurring chokes, worn components, loose fixtures, moisture or unreliable operation.</p></article><article><h3>Why prompt attention matters</h3><p>Early action can reduce water damage, disruption and the risk of a smaller fault affecting nearby finishes.</p></article></div><ul class="checks"><li><CheckCircle2/> Careful diagnosis before work begins</li><li><CheckCircle2/> Clear scope and pricing</li><li><CheckCircle2/> Suitable materials for the application</li><li><CheckCircle2/> Final checks and clean handover</li></ul></div><aside><ServiceIcon/><h3>Need help now?</h3><p>Share a photo or describe the symptoms on WhatsApp.</p><a class="btn btn-primary" target="_blank" rel="noopener" href="https://wa.me/6568174420"><MessageCircle size={17}/> WhatsApp PrimeFlow</a><small>Available 24/7 across Singapore</small></aside></div></section>
<section class="subservices section"><div class="container"><div class="section-head"><div><span class="eyebrow">Related solutions</span><h2>{service.title} services.</h2></div><p class="lead">Choose a service for detailed information, or contact us if you are not sure which option fits the problem.</p></div><div class="sub-grid">{service.subservices.map((sub,i)=><a href={`/services/${service.slug}/${slugify(sub)}`}><div class="sub-icon"><ServiceIcon/></div><span>{String(i+1).padStart(2,'0')}</span><h3>{sub}</h3><p>Careful inspection and a practical, clearly explained solution for Singapore properties.</p><b>Learn more <ArrowUpRight size={14}/></b></a>)}</div></div></section>
<section class="section why-service"><div class="container"><div class="center-heading"><span class="eyebrow">Why choose PrimeFlow</span><h2>Professional help without the uncertainty.</h2></div><div class="reason-grid">{reasons.map(([Icon,title,copy])=><article><div><Icon/></div><h3>{title}</h3><p>{copy}</p></article>)}</div></div></section>
<section class="process section"><div class="container"><div class="section-head"><div><span class="eyebrow">Our process</span><h2>From first contact to professional completion.</h2></div></div><div class="steps">{[['01','Contact Us','Call, WhatsApp or send a quote request.'],['02','Inspection & Diagnosis','We assess the affected plumbing and identify the likely cause.'],['03','Solution & Quote','We explain the practical options and confirm pricing.'],['04','Complete Professional Repair','Approved work is completed, tested and handed over tidily.']].map(([n,t,c])=><div><span>{n}</span><h3>{t}</h3><p>{c}</p></div>)}</div><div class="coverage"><MapPin/><div><h3>Islandwide service coverage</h3><p>Central · East · West · North · North-East · South Singapore</p></div><a class="btn btn-light" href="/contact">Check availability</a></div></div></section>
<section class="section"><div class="container faq-grid"><div><span class="eyebrow">Frequently asked</span><h2>{service.title} questions.</h2></div><FAQ faqs={localFaqs}/></div></section>
<section class="section related"><div class="container"><span class="eyebrow">Related services</span><h2>You may also need.</h2><div class="grid-3">{related.map(s=><ServiceCard service={s}/>)}</div></div></section>
<section class="final-cta"><div class="container"><div><span>Available islandwide</span><h2>Need professional plumbing help?</h2><p>Tell us what is happening and get a clear recommendation from the PrimeFlow team.</p></div><div><a class="btn btn-light" target="_blank" rel="noopener" href="https://wa.me/6568174420"><MessageCircle size={17}/> WhatsApp Us</a><a class="btn btn-primary" href="/contact">Get Free Quote <ArrowUpRight size={16}/></a></div></div></section>
</Layout>
<style>.service-hero{padding:145px 0 70px;background:#061a35;color:white}.service-hero nav{display:flex;gap:9px;font-size:.7rem;color:#90a4ba;margin:22px 0 40px}.hero-grid{display:grid;grid-template-columns:1fr .78fr;gap:60px;align-items:center}.hero-grid h1{font-size:clamp(3rem,5.8vw,5.5rem)}.hero-grid h1 em{font-style:normal;color:#56a5ff}.hero-grid p{color:#b8c6d5;line-height:1.75;max-width:650px}.hero-grid img{width:100%;height:450px;object-fit:cover;border-radius:20px}.actions{display:flex;gap:10px;margin-top:28px}.intro-grid{display:grid;grid-template-columns:1fr .65fr;gap:80px}.overview-points{display:grid;gap:10px;margin:28px 0}.overview-points article{border-left:3px solid #2587f5;background:#f7f9fb;padding:15px 18px;border-radius:0 10px 10px 0}.overview-points h3{font-size:.88rem;margin:0 0 5px}.overview-points p{margin:0;color:#6c7b8e;font-size:.78rem;line-height:1.55}.checks{list-style:none;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:28px}.checks li{display:flex;gap:8px;font-size:.82rem}.checks svg{width:18px;color:#1877f2;flex:none}.intro-grid aside{background:#eef6ff;border-radius:18px;padding:30px;align-self:start}.intro-grid aside>svg{width:48px;height:48px;padding:12px;border-radius:12px;background:#1877f2;color:white;margin-bottom:25px}.intro-grid aside small{display:block;margin-top:13px;color:#75859a}.subservices{background:#f4f7fa}.section-head{display:grid;grid-template-columns:1.2fr 1fr;gap:60px;align-items:end;margin-bottom:40px}.sub-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.sub-grid a{position:relative;background:white;border:1px solid #dfe7ef;border-radius:15px;padding:23px;transition:.2s}.sub-grid a:hover{transform:translateY(-4px);border-color:#b8d8fb;box-shadow:0 18px 38px #092a5018}.sub-icon{width:42px;height:42px;display:grid;place-items:center;border-radius:11px;background:#eaf4ff;color:#1877f2;margin-bottom:18px}.sub-icon svg{width:20px}.sub-grid span{position:absolute;right:20px;top:22px;color:#9aabba;font-size:.66rem;font-weight:800}.sub-grid h3{font-size:1rem;margin:0 0 8px}.sub-grid p{color:#738195;font-size:.78rem;line-height:1.55}.sub-grid b{display:flex;align-items:center;gap:5px;font-size:.75rem;color:#1877f2}.center-heading{text-align:center;max-width:730px;margin:0 auto 38px}.reason-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}.reason-grid article{border:1px solid #dee6ee;border-radius:15px;padding:22px}.reason-grid article>div{width:40px;height:40px;border-radius:10px;background:#eaf4ff;color:#1877f2;display:grid;place-items:center}.reason-grid svg{width:19px}.reason-grid h3{font-size:.9rem;margin:28px 0 8px}.reason-grid p{font-size:.73rem;line-height:1.55;color:#718095}.process{background:#061a35;color:white}.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.steps>div{border-top:1px solid #536377;padding:24px 10px}.steps span{color:#52a2ff;font-weight:800}.steps h3{font-size:1rem;margin:35px 0 8px}.steps>div>p{color:#aab9c9;font-size:.74rem;line-height:1.55}.coverage{display:flex;align-items:center;gap:18px;margin-top:60px;background:#1877f2;border-radius:15px;padding:22px}.coverage>svg{width:35px}.coverage p{margin:0;color:#ddecff}.coverage h3{margin-bottom:5px}.coverage .btn{margin-left:auto}.faq-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:60px}.related{background:#f8fafc}.related h2{margin-bottom:35px}.final-cta{padding:75px 0;background:#061a35;color:white;border-top:1px solid #ffffff15}.final-cta .container{display:flex;align-items:center;justify-content:space-between;gap:40px}.final-cta span{color:#56a5ff;font-size:.68rem;text-transform:uppercase;letter-spacing:.1em;font-weight:800}.final-cta h2{font-size:clamp(2rem,4vw,3.3rem);margin:10px 0}.final-cta p{color:#aebdcd;margin:0}.final-cta .container>div:last-child{display:flex;gap:10px;flex:none}@media(max-width:950px){.reason-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:800px){.hero-grid,.intro-grid,.section-head,.faq-grid{grid-template-columns:1fr}.hero-grid img{height:360px}.sub-grid{grid-template-columns:1fr 1fr}.steps{grid-template-columns:1fr 1fr}.coverage{align-items:flex-start;flex-wrap:wrap}.coverage .btn{margin-left:0}.final-cta .container{display:grid}.final-cta .container>div:last-child{flex-wrap:wrap}}@media(max-width:600px){.reason-grid{grid-template-columns:1fr 1fr}}@media(max-width:520px){.sub-grid,.checks,.steps,.reason-grid{grid-template-columns:1fr}}</style>
