---
import Layout from '../../../layouts/Layout.astro'; import FAQ from '../../../components/FAQ.astro'; import {services,slugify} from '../../../data/services'; import { Phone,MessageCircle,CheckCircle2,Search,ClipboardCheck,Wrench,ShieldCheck } from 'lucide-astro';
import { Picture } from 'astro:assets';
import serviceImage from '../../../assets/service-plumber.webp';
export function getStaticPaths(){return services.flatMap(service=>service.subservices.map(sub=>({params:{service:service.slug,subservice:slugify(sub)},props:{service,sub}})))}
const {service,sub}=Astro.props; const siblings=service.subservices.filter(x=>x!==sub).slice(0,4); const faq=[[`What does ${sub.toLowerCase()} involve?`,'We first inspect the affected fixtures and connections, then explain the most appropriate repair or installation method for your property.'],['Will you confirm the price before starting?','Yes. We explain the work and pricing for approval before we proceed.'],['Do you serve my area in Singapore?','Yes. Prime Plumbing SG provides islandwide service for HDB, condo, landed and commercial properties.']];
const schema={'@context':'https://schema.org','@type':'Service',name:`${sub} Singapore`,serviceType:sub,provider:{'@type':'Plumber','@id':'https://primeplumbingsg.com/#business',name:'Prime Plumbing SG',telephone:'+65 8183 6772'},areaServed:'Singapore'};
---
<Layout title={`${sub} Singapore | Prime Plumbing SG`} description={`Professional ${sub.toLowerCase()} from Prime Plumbing SG for HDB, condo, landed and commercial properties across Singapore. Call +65 8183 6772 for a quote.`} schema={schema}>
<section class="hero"><div class="container"><nav><a href="/">Home</a> / <a href="/services">Services</a> / <a href={`/services/${service.slug}`}>{service.title}</a> / <b>{sub}</b></nav><div class="hero-grid"><div><span class="eyebrow">{service.title}</span><h1>{sub}<br/><em>in Singapore</em></h1><p>Careful assessment, clear recommendations and professional work for homes and businesses across the island.</p><div><a class="btn btn-primary" href="/contact">Get a Quote</a><a class="btn btn-light" href="tel:+6581836772"><Phone size={17}/> Call Now</a></div></div><Picture src={service.image} formats={['avif']} fallbackFormat="webp" widths={[480,720,960]} sizes="(max-width: 800px) 100vw, 44vw" alt={`Professional ${sub.toLowerCase()} in Singapore`} loading="eager" decoding="async" fetchpriority="high" style="width:100%;height:430px;object-fit:cover;border-radius:20px" /></div></div></section>
<section class="section"><div class="container split"><div><span class="eyebrow">What this service involves</span><h2>A proper fix starts with the cause.</h2><p class="lead">For {sub.toLowerCase()}, we assess the visible symptoms, relevant connections and surrounding area before recommending work. This helps avoid unnecessary replacement and reduces the chance of the issue returning.</p><p>Once you approve the scope, we protect the work area, complete the service with suitable parts and test the result before handover.</p></div><div class="benefits"><h3>What you can expect</h3>{['A careful, relevant inspection','Clear explanation of the options','Upfront scope and pricing','Professional tools and materials','Functional checks before handover'].map(x=><p><CheckCircle2/>{x}</p>)}</div></div></section>
<section class="problem section"><div class="container split reverse"><div class="image"><Picture src={serviceImage} formats={['avif']} fallbackFormat="webp" widths={[480,720,960]} sizes="(max-width: 800px) 100vw, 45vw" alt={`Plumber carrying out ${sub.toLowerCase()}`} loading="lazy" decoding="async" style="width:100%;height:460px;object-fit:cover;border-radius:18px"/></div><div><span class="eyebrow">Common signs</span><h2>When it’s worth calling a plumber.</h2><p class="lead">Recurring moisture, unusual sounds, slow flow, unstable fittings, stains, odours or a sudden change in water pressure can all point to a plumbing issue that deserves attention.</p><p>Stop using the affected fixture if continued use could cause damage. For active leaks, turn off the nearest safe water supply and call our emergency line.</p><a class="btn btn-primary" href="tel:+6581836772"><Phone size={17}/> +65 8183 6772</a></div></div></section>
<section class="section process"><div class="container"><div class="title"><span class="eyebrow">Our process</span><h2>Simple, careful and accountable.</h2></div><div class="steps">{[[Search,'01','Inspect'],[ClipboardCheck,'02','Explain & quote'],[Wrench,'03','Complete the work'],[ShieldCheck,'04','Test & hand over']].map(([Icon,n,t])=><article><Icon/><span>{n}</span><h3>{t}</h3><p>Clear communication at every stage, with the work area treated carefully.</p></article>)}</div></div></section>
<section class="section faq"><div class="container split"><div><span class="eyebrow">Questions answered</span><h2>Before you book.</h2></div><FAQ faqs={faq}/></div></section>
<section class="related section"><div class="container"><span class="eyebrow">Related {service.title} services</span><h2>Other ways we can help.</h2><div class="links">{siblings.map(x=><a href={`/services/${service.slug}/${slugify(x)}`}>{x}<span>↗</span></a>)}</div></div></section>
<section class="cta"><div class="container"><div><span>Ready for the next step?</span><h2>Tell us what’s happening.</h2></div><div><a class="btn btn-light" href="/contact">Get a Free Quote</a><a class="btn btn-outline" target="_blank" rel="noopener noreferrer" href="https://wa.me/6581836772"><MessageCircle size={17}/> WhatsApp</a></div></div></section>
</Layout>
<style>.hero{background:#061a35;color:white;padding:150px 0 75px}.hero nav{color:#8ea1b7;font-size:.67rem;margin:15px 0 40px}.hero nav a{color:#bfccda}.hero-grid{display:grid;grid-template-columns:1.05fr .8fr;gap:60px;align-items:center}.hero h1{font-size:clamp(2.8rem,5.4vw,5rem)}.hero h1 em{font-style:normal;color:#53a3ff}.hero p{color:#b9c7d6;line-height:1.7;max-width:620px}.hero-grid>div>div{display:flex;gap:10px;margin-top:28px}.hero img{width:100%;height:430px;object-fit:cover;border-radius:20px}.split{display:grid;grid-template-columns:1fr .8fr;gap:90px;align-items:center}.split>div>p:not(.lead){color:#68788d;line-height:1.7}.benefits{padding:30px;background:#f1f6fb;border-radius:18px}.benefits p{display:flex;gap:9px;align-items:center;border-bottom:1px solid #dbe5ef;padding:12px 0;margin:0;font-size:.82rem}.benefits svg{width:18px;color:#1877f2}.problem{background:#f5f7f9}.image img{width:100%;height:460px;object-fit:cover;border-radius:18px}.reverse{grid-template-columns:.85fr 1fr}.title{text-align:center;margin-bottom:40px}.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.steps article{border:1px solid #dce5ee;border-radius:15px;padding:25px}.steps svg{color:#1877f2}.steps span{float:right;color:#a1aebb;font-size:.7rem}.steps h3{margin-top:45px}.steps p{color:#718095;font-size:.78rem;line-height:1.6}.faq{background:#f7f9fb}.related h2{margin-bottom:30px}.links{display:grid;grid-template-columns:1fr 1fr;gap:12px}.links a{padding:20px;border:1px solid #dce4ed;border-radius:12px;font-weight:500;font-size:.85rem;display:flex;justify-content:space-between}.links a:hover{border-color:#1877f2;color:#1877f2}.cta{padding:60px 0;background:#1877f2;color:white}.cta .container{display:flex;justify-content:space-between;align-items:center}.cta h2{font-size:2.3rem;margin:8px 0}.cta>div>div:last-child{display:flex;gap:10px}.cta .btn-outline{background:transparent;color:white;border-color:#ffffff70}@media(max-width:800px){.hero-grid,.split,.reverse{grid-template-columns:1fr}.steps{grid-template-columns:1fr 1fr}.cta .container{display:grid;gap:25px}.hero img{height:350px}}@media(max-width:520px){.steps,.links{grid-template-columns:1fr}}</style>
