---
import { faqs as defaultFaqs } from '../data/services';
const { faqs=defaultFaqs, limit }=Astro.props; const rows=limit?faqs.slice(0,limit):faqs;
---
<div class="faqs">{rows.map(([q,a],i)=><details open={i===0}><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</div>
<style>.faqs{display:grid;gap:10px}.faqs details{background:#f5f7fa;border:1px solid #edf1f5;border-radius:12px;overflow:hidden}.faqs summary{padding:18px 20px;cursor:pointer;display:flex;justify-content:space-between;gap:20px;font-weight:800;list-style:none}.faqs summary span{color:#1678ec;font-size:1.25rem}.faqs details[open] summary span{transform:rotate(45deg)}.faqs p{margin:0;padding:0 20px 20px;color:#627185;line-height:1.7;font-size:.9rem}</style>
