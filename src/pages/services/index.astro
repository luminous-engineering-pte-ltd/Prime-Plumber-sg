---
import Layout from '../../layouts/Layout.astro'; import ServiceCard from '../../components/ServiceCard.astro'; import { services } from '../../data/services'; import { Phone } from 'lucide-astro';
---
<Layout title="Plumbing Services Singapore | PrimeFlow" description="Explore 60+ plumbing services across nine specialist categories, from leak repair and choke clearing to water heaters and commercial plumbing.">
<section class="page-hero"><div class="container"><span class="eyebrow">Plumbing services Singapore</span><h1>Professional plumbing,<br/>properly organised.</h1><p>Find the right help quickly. Our nine service categories cover common repairs, careful installations and urgent plumbing work across Singapore.</p><div><a class="btn btn-primary" href="/contact">Get a Free Quote</a><a class="btn btn-light" href="tel:+6568174420"><Phone size={17}/> +65 6817 4420</a></div></div></section>
<section class="section"><div class="container"><div class="intro"><h2>Complete plumbing services built around your needs.</h2><p class="lead">Each category opens into detailed service options, so you can understand what the work involves before you book.</p></div><div class="grid-3">{services.map(s=><ServiceCard service={s}/>)}</div></div></section>
<section class="cta"><div class="container"><div><span>Not sure which service fits?</span><h2>Tell us what you’re seeing.</h2></div><a class="btn btn-light" href="/contact">Describe the problem →</a></div></section>
</Layout>
<style>.page-hero{padding:190px 0 100px;background:#061a35;color:white}.page-hero h1{font-size:clamp(3rem,6vw,5.8rem);max-width:850px;margin:20px 0}.page-hero p{color:#b5c4d4;max-width:680px;line-height:1.7;font-size:1.07rem}.page-hero>div>div{display:flex;gap:10px;margin-top:28px}.intro{display:grid;grid-template-columns:1.3fr 1fr;gap:70px;align-items:end;margin-bottom:45px}.cta{background:#1877f2;color:white;padding:55px 0}.cta .container{display:flex;align-items:center;justify-content:space-between}.cta span{font-size:.75rem;text-transform:uppercase;font-weight:800}.cta h2{font-size:2.3rem;margin:8px 0 0}@media(max-width:650px){.intro{grid-template-columns:1fr;gap:10px}.cta .container{display:grid;gap:25px}}</style>
