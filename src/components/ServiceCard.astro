---
import * as icons from 'lucide-astro';
import { Picture } from 'astro:assets';
const { service, featured=false } = Astro.props; const Icon=icons[service.icon] || icons.Wrench;
---
<article class:list={['service-card card',featured&&'featured']}>
{featured && <div class="visual"><Picture src={service.image} formats={['avif']} fallbackFormat="webp" widths={[360,560,760]} sizes="(max-width: 620px) calc(100vw - 28px), (max-width: 900px) 50vw, 380px" alt={`${service.title} technician in Singapore`} loading="lazy" decoding="async" /></div>}
  <div class="service-icon"><Icon/></div><p class="count">{String(service.subservices.length).padStart(2,'0')} specialist services</p><h3>{service.title}</h3><p>{service.description}</p><ul>{service.subservices.slice(0,4).map(item=><li>{item}</li>)}</ul><a href={`/services/${service.slug}`}>View all services <span>↗</span></a>
</article>
<style>.service-card{padding:25px;transition:.22s ease;overflow:hidden}.service-card:hover{transform:translateY(-5px);box-shadow:0 24px 50px #0a28511c}.service-icon{width:46px;height:46px;border-radius:12px;background:#e9f3ff;color:#1877f2;display:grid;place-items:center}.service-icon :global(svg){width:22px}.count{color:#247de6!important;text-transform:uppercase;font-size:.68rem!important;font-weight:500;letter-spacing:.08em;margin:17px 0 7px!important}.service-card h3{font-size:1.26rem;margin-bottom:9px}.service-card p{color:#68778b;line-height:1.55;font-size:.9rem}.service-card ul{list-style:none;padding:0;margin:18px 0;border-top:1px solid #e5ebf1}.service-card li{padding:8px 0;border-bottom:1px solid #edf1f5;color:#46566a;font-size:.78rem}.service-card li:before{content:'✓';color:#1682fa;font-weight:600;margin-right:8px}.service-card a{display:flex;justify-content:space-between;align-items:center;font-weight:500;font-size:.83rem;margin-top:19px}.visual{height:185px;margin:-25px -25px 20px}.visual :global(picture){display:block;height:100%}.visual :global(img){width:100%;height:100%;object-fit:cover}</style>
