---
import Layout from '../layouts/Layout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import QuoteForm from '../components/QuoteForm.astro';
import FAQ from '../components/FAQ.astro';
import { services, faqs } from '../data/services';
import { Phone, MessageCircle, Clock3, BadgeDollarSign, Wrench, ShieldCheck, Building2, Home, CheckCircle2, ArrowUpRight, Star, MapPin } from 'lucide-astro';
const homeSchema = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
const benefits=[[Clock3,'Fast response','A practical arrival estimate and clear updates from first call to completion.'],[BadgeDollarSign,'Transparent pricing','The recommended scope and pricing are explained before work begins.'],[Wrench,'Experienced plumbers','Skilled hands for everyday repairs, careful installations and urgent problems.'],[ShieldCheck,'Quality workmanship','Sound materials, tidy work and final checks built into every visit.'],[MapPin,'Islandwide service','Responsive support across every region of Singapore.'],[MessageCircle,'Customer first','Straight answers and solutions chosen for long-term reliability.']];
---
<Layout title="Plumber Singapore | 24/7 Plumbing Services | Prime Plumbing SG" description="Prime Plumbing SG provides professional plumbing services across Singapore for pipe leaks, drain chokes, toilets, water heaters, HDBs and commercial properties. Call +65 8183 6772." schema={homeSchema}>
  <section class="hero">
    <img src="/images/hero-plumber.png" alt="Prime Plumbing SG plumber arriving at a Singapore home" fetchpriority="high" />
    <div class="shade"></div><div class="container hero-copy reveal"><span class="hero-tag"><i></i> 24/7 plumbing response across Singapore</span><h1>Plumbing done right.<br/><em>Without the runaround.</em></h1><p>From a dripping pipe in your HDB flat to an urgent drain choke at your business, get clear advice and dependable work from a local team.</p><div class="actions"><a class="btn btn-primary" href="/contact">Get a Free Quote <ArrowUpRight size={17}/></a><a class="btn btn-light" href="tel:+6581836772"><Phone size={17}/> +65 8183 6772</a></div><div class="trust"><span><CheckCircle2/> Islandwide</span><span><CheckCircle2/> Clear pricing</span><span><CheckCircle2/> 24/7 emergencies</span></div></div>
    <div class="availability"><span><Clock3/></span><div><b>Need urgent help?</b><small>Emergency line is open now</small></div><a href="tel:+6581836772">Call now →</a></div>
  </section>
  <div class="container float-form card"><p><b>Need a plumber?</b><span>Tell us the basics. We’ll call you back.</span></p><QuoteForm compact /></div>

  <section class="section services" id="services"><div class="container"><div class="heading-row"><div><span class="eyebrow">Our services</span><h2>Specialist plumbing for<br/>every kind of property.</h2></div><p class="lead">From precise repairs to complete installations, every job starts with a proper look at the problem—not a guess.</p></div><div class="grid-3 service-grid">{services.slice(0,6).map((s,i)=><ServiceCard service={s} featured={i<3}/>)}</div><div class="center"><a class="btn btn-outline" href="/services">Explore all 9 service categories <ArrowUpRight size={16}/></a></div></div></section>

  <section class="section why"><div class="container"><div class="why-head"><span class="eyebrow">Why Prime Plumbing SG</span><h2>Good plumbing should feel straightforward.</h2><p class="lead">We arrive prepared, communicate clearly and leave your space as carefully as we found it.</p></div><div class="why-layout"><div class="why-image"><img src="/images/service-plumber.png" alt="Prime Plumbing SG plumber repairing a pipe in a Singapore apartment" loading="lazy"/><div class="stat"><strong>4.9<small>/5</small></strong><span>Average customer rating</span></div></div><div class="benefit-list">{benefits.map(([Icon,title,copy],i)=><article><div><Icon/></div><span>{String(i+1).padStart(2,'0')}</span><h3>{title}</h3><p>{copy}</p></article>)}</div></div></div></section>

  <section class="section about"><div class="container about-grid"><div><span class="eyebrow">Built for Singapore</span><h2>Local knowledge. Careful work. No mystery.</h2><p class="lead">Prime Plumbing SG supports HDB flats, condos, landed homes and working businesses with a practical approach shaped around Singapore’s plumbing systems and property requirements.</p><p>We diagnose before recommending work, explain what matters, and help you choose a repair that makes sense for the property—not simply the biggest job.</p><a class="btn btn-primary" href="/about">Meet Prime Plumbing SG <ArrowUpRight size={16}/></a></div><div class="property-cards"><article><Home/><h3>Residential</h3><p>HDB · Condo · Landed · Apartments</p></article><article><Building2/><h3>Commercial</h3><p>Offices · Clinics · Restaurants · Retail</p></article><div class="numbers"><span><strong>24/7</strong>Emergency response</span><span><strong>6</strong>Singapore regions</span><span><strong>9</strong>Service categories</span></div></div></div></section>

  <section class="emergency"><div class="container emergency-grid"><div><span class="hero-tag"><i></i> available 24/7</span><h2>Plumbing emergency?<br/>We’re ready to help.</h2><p>Leaks, burst pipes and serious chokes can quickly cause damage. Get fast plumbing assistance when you need it.</p><div class="actions"><a class="btn btn-primary" href="tel:+6581836772"><Phone size={17}/> Call Now</a><a class="btn btn-light" target="_blank" rel="noopener noreferrer" href="https://wa.me/6581836772"><MessageCircle size={17}/> WhatsApp Us</a></div></div><div class="emergency-img"><img src="/images/hero-plumber.png" alt="Emergency plumber in Singapore" loading="lazy" /></div></div></section>

  <section class="section process"><div class="container"><div class="section-title"><span class="eyebrow">How it works</span><h2>Four clear steps. One less thing to worry about.</h2></div><div class="grid-4 steps">{[['01','Contact us','Call, WhatsApp or send a quote request.'],['02','Describe the problem','Share what you see, hear or smell—and photos if useful.'],['03','Get a clear solution','We inspect, explain the options and confirm the price.'],['04','We complete the job','Careful work, tidy handover and a final functional check.']].map(([n,t,c])=><article class="card"><span>{n}</span><h3>{t}</h3><p>{c}</p></article>)}</div></div></section>

  <section class="section testimonials"><div class="container"><div class="testimonial-head"><div><span class="hero-tag"><i></i> customer stories</span><h2>What our customers say.</h2></div><div class="rating"><strong>4.9</strong><span>★★★★★<small>Average customer rating</small></span></div></div><div class="grid-3 reviews">{[['Michelle Tan','HDB · Tampines','“The plumber found the source of the kitchen leak quickly, explained the repair clearly and left the cabinet area spotless.”'],['Marcus Lim','Condo · Bishan','“We called late about a badly choked floor trap. The updates were clear, the arrival time was accurate and the drain is flowing well again.”'],['Farah Rahman','Retail · Bugis','“Prime Plumbing SG worked around our opening hours and kept us informed. Professional, practical and easy to deal with.”']].map(([name,type,quote],i)=><article><div class="stars">★★★★★</div><blockquote>{quote}</blockquote><div class="person"><span>{name.charAt(0)}</span><div><b>{name}</b><small>{type}</small></div></div></article>)}</div></div></section>

  <section class="section areas"><div class="container areas-grid"><div><span class="eyebrow">Islandwide coverage</span><h2>Plumbing services across Singapore.</h2><p class="lead">We plan routes across the island for responsive residential and commercial attendance.</p><div class="regions">{['Central Singapore','East','West','North','North-East','South'].map(x=><span><MapPin size={15}/>{x}</span>)}</div><a class="btn btn-primary" href="/contact">Check availability</a></div><div class="sg-visual"><div class="rings"></div><strong>SG</strong><span>Islandwide</span>{['HDB','CONDO','LANDED','COMMERCIAL'].map((x,i)=><i style={`--i:${i}`}>{x}</i>)}</div></div></section>

  <section class="section faq-section" id="faq"><div class="container"><div class="faq-grid"><div><span class="eyebrow">Questions, answered</span><h2>Helpful answers before you book.</h2><p class="lead">Still unsure? Call us and describe the issue. We’ll help you decide what to do next.</p><img src="/images/service-plumber.png" alt="Plumber working beneath a kitchen sink" loading="lazy" /></div><FAQ limit={6}/></div></div></section>

  <section class="section insights" id="insights"><div class="container"><div class="section-title"><span class="eyebrow">Practical advice</span><h2>Helpful plumbing tips & insights.</h2></div><div class="grid-3 articles">{[['Leaks','5 warning signs of a hidden water leak','Small changes in pressure, sound and your water bill can point to a problem out of sight.'],['Drain care','How to prevent kitchen sink chokes','A few everyday habits can keep grease and food waste from building up inside the trap.'],['Water heaters','When should you replace your water heater?','Know the signs that a repair may no longer be the safest or most economical option.']].map(([cat,title,copy],i)=><article class="card"><div class="article-img"><img src={i===1?'/images/hero-plumber.png':'/images/service-plumber.png'} alt={title} loading="lazy"/></div><div class="article-body"><span>{cat} · 5 min read</span><h3>{title}</h3><p>{copy}</p><a href="/contact">Read article →</a></div></article>)}</div></div></section>

  <section class="section quote-section"><div class="container quote-grid"><div><span class="eyebrow">Get a quote</span><h2>Tell us what needs fixing.</h2><p class="lead">Describe your plumbing issue and our team will get back to you with the next steps.</p><div class="direct"><a href="tel:+6581836772"><Phone/> <span><small>Call us 24/7</small><b>+65 8183 6772</b></span></a><a target="_blank" rel="noopener noreferrer" href="https://wa.me/6581836772"><MessageCircle/> <span><small>Message us</small><b>WhatsApp Prime Plumbing SG</b></span></a></div></div><div class="form-card card"><QuoteForm /></div></div></section>
</Layout>

<style>
