---
import Layout from '../layouts/Layout.astro'; import { CheckCircle2, Home, Building2, ShieldCheck, MessageCircle } from 'lucide-astro';
const values=[['Straight answers','We explain what we find in plain language and recommend only the work that makes practical sense.'],['Respect for your property','We protect the work area, keep tools organised and clean up before handover.'],['Long-term thinking','We consider the system around the problem, not only the symptom in front of us.']];
---
<Layout title="About PrimeFlow Plumbing Singapore" description="Meet PrimeFlow Plumbing: a Singapore plumbing team built around careful diagnosis, clear communication and reliable work for homes and businesses.">
<section class="hero"><div class="container hero-grid"><div><span class="eyebrow">About PrimeFlow</span><h1>Plumbing service built on clarity.</h1><p>PrimeFlow was created around a simple belief: customers deserve to understand what is happening in their property, what should be done and what it will cost.</p><a class="btn btn-primary" href="/contact">Talk to our team →</a></div><img src="/images/hero-plumber.png" alt="PrimeFlow plumber serving a Singapore home" /></div></section>
<section class="section"><div class="container story"><div><span class="eyebrow">Our approach</span><h2>Careful work starts before the toolbox opens.</h2></div><div><p class="lead">We ask the right questions, inspect the relevant system and give you a practical view of the options.</p><p>That approach supports better outcomes across quick repairs, planned fixture upgrades, leak investigation and commercial maintenance. It also keeps the process calm when the problem is urgent.</p></div></div></section>
<section class="values section"><div class="container"><div class="title"><span class="eyebrow">What guides us</span><h2>Professional standards that show up in the details.</h2></div><div class="grid-3">{values.map(([t,c],i)=><article><span>0{i+1}</span><h3>{t}</h3><p>{c}</p></article>)}</div></div></section>
<section class="section"><div class="container expertise"><img src="/images/service-plumber.png" alt="PrimeFlow technician working in a modern apartment" loading="lazy"/><div><span class="eyebrow">Residential & commercial</span><h2>One careful standard, across every property type.</h2><p class="lead">Singapore buildings come with different access, operating and plumbing considerations. We plan the work around the property.</p><div class="types"><div><Home/><h3>Homes</h3><p>HDB flats, condos, apartments and landed properties.</p></div><div><Building2/><h3>Businesses</h3><p>Offices, clinics, restaurants and retail shops.</p></div></div><ul><li><CheckCircle2/> Islandwide attendance</li><li><CheckCircle2/> 24/7 emergency support</li><li><CheckCircle2/> Clear pre-work quotations</li></ul></div></div></section>
<section class="trust"><div class="container"><ShieldCheck/><div><span>Why customers trust PrimeFlow</span><h2>Prepared plumbers. Clear decisions. Work that holds up.</h2></div><div class="stats"><strong>24/7<small>Emergency line</small></strong><strong>9<small>Service categories</small></strong><strong>6<small>Regions covered</small></strong></div></div></section>
<section class="cta"><div class="container"><div><span>Have a plumbing question?</span><h2>Send us a photo on WhatsApp.</h2></div><a class="btn btn-light" target="_blank" rel="noopener" href="https://wa.me/6568174420"><MessageCircle size={17}/> Start a conversation</a></div></section>
</Layout>
<style>.hero{background:#061a35;color:white;padding:160px 0 70px}.hero-grid{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center}.hero h1{font-size:clamp(3.2rem,6vw,5.7rem)}.hero p{color:#b8c6d5;line-height:1.75;font-size:1.05rem;max-width:580px}.hero img{width:100%;height:500px;object-fit:cover;border-radius:22px}.story{display:grid;grid-template-columns:1fr 1fr;gap:90px}.story p:not(.lead){color:#6c7b8e;line-height:1.75}.values{background:#f5f7f9}.title{text-align:center;max-width:720px;margin:0 auto 40px}.values article{background:white;padding:28px;border-radius:15px;border:1px solid #e0e7ee}.values article>span{color:#1877f2;font-size:.7rem;font-weight:800}.values h3{margin-top:48px}.values p{color:#6d7b8e;font-size:.85rem;line-height:1.65}.expertise{display:grid;grid-template-columns:1fr 1fr;gap:75px;align-items:center}.expertise>img{width:100%;height:600px;object-fit:cover;border-radius:20px}.types{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:25px 0}.types>div{background:#f2f6fa;padding:20px;border-radius:13px}.types svg{color:#1877f2}.types p{font-size:.77rem;color:#718094}.expertise ul{list-style:none;padding:0}.expertise li{display:flex;gap:8px;margin:12px 0;font-size:.85rem}.expertise li svg{width:17px;color:#1877f2}.trust{background:#061a35;color:white;padding:70px 0}.trust .container{display:grid;grid-template-columns:auto 1fr 1fr;gap:30px;align-items:center}.trust .container>svg{width:50px;height:50px;color:#55a4ff}.trust h2{font-size:2rem;margin:8px 0}.trust span{color:#8fa2b8;font-size:.75rem}.stats{display:flex;justify-content:space-around}.stats strong{font-size:2rem}.stats small{display:block;font-size:.65rem;color:#91a5ba}.cta{background:#1877f2;color:white;padding:55px 0}.cta .container{display:flex;align-items:center;justify-content:space-between}.cta h2{font-size:2.2rem;margin:8px 0}.cta span{font-size:.7rem;text-transform:uppercase;font-weight:800}@media(max-width:800px){.hero-grid,.story,.expertise,.trust .container{grid-template-columns:1fr}.hero img{height:390px}.stats{justify-content:space-between}.cta .container{display:grid;gap:20px}}@media(max-width:450px){.types{grid-template-columns:1fr}}</style>
