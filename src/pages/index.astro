tretch}.center{text-align:center;margin-top:35px}.why{background:#f4f7fa}.why-head{text-align:center;max-width:720px;margin:0 auto 45px}.why-layout{display:grid;grid-template-columns:.9fr 1.1fr;gap:24px}.why-image{position:relative;min-height:630px;border-radius:20px;overflow:hidden}.why-image img{width:100%;height:100%;object-fit:cover}.stat{position:absolute;left:20px;right:20px;bottom:20px;background:#087ff5;color:white;border-radius:14px;padding:22px;display:flex;align-items:end;justify-content:space-between}.stat strong{font-size:2.4rem}.stat small{font-size:1rem}.stat span{font-size:.78rem}.benefit-list{display:grid;grid-template-columns:1fr 1fr;gap:12px}.benefit-list article{background:white;border:1px solid #e0e7ef;border-radius:16px;padding:24px}.benefit-list article>div{width:40px;height:40px;border-radius:10px;background:#e9f3ff;color:#167df0;display:grid;place-items:center}.benefit-list svg{width:20px}.benefit-list article>span{float:right;margin-top:-38px;color:#a4b0be;font-size:.7rem;font-weight:800}.benefit-list h3{margin:22px 0 8px}.benefit-list p{color:#6d7b8d;line-height:1.6;font-size:.82rem}.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:85px;align-items:center}.about-grid>div>p:not(.lead){color:#69788c;line-height:1.7}.property-cards{display:grid;grid-template-columns:1fr 1fr;gap:13px}.property-cards article{border-radius:16px;padding:28px;background:#f5f8fb}.property-cards article svg{color:#1877f2}.property-cards article p{color:#758398;font-size:.78rem}.numbers{grid-column:1/-1;background:#061a35;color:white;border-radius:16px;padding:24px;display:grid;grid-template-columns:repeat(3,1fr)}.numbers span{font-size:.7rem;color:#9eafc2}.numbers strong{font-size:1.7rem;display:block;color:white}.emergency{background:#061a35;color:white}.emergency-grid{display:grid;grid-template-columns:1fr 1fr;min-height:560px;align-items:center}.emergency h2{margin-top:20px}.emergency p{max-width:570px;color:#b7c5d4;line-height:1.7}.emergency-img{height: