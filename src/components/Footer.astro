<style>footer{background:#061a35;color:white;padding:80px 0 25px}.foot-grid{display:grid;grid-template-columns:1.5fr repeat(3,1fr);gap:70px;padding-bottom:60px;border-bottom:1px solid #ffffff22}.logo{font-size:1.4rem;font-weight:800;display:flex;align-items:center;gap:8px}.foot-grid p{color:#aab9cb;line-height:1.7;max-width:350px}.foot-grid h3{font-size:.78rem;text-transform:uppercase;letter-spacing:.1em}.foot-grid>div>a,.foot-grid>div>span{display:flex;align-items:flex-start;gap:8px;color:#b9c5d3;font-size:.86rem;margin:14px 0}.foot-grid svg{width:17px}.social{display:flex;gap:10px}.social a{border:1px solid #ffffff30;padding:8px;border-radius:8px}.bottom{display:flex;justify-content:space-between;color:#8495a9;padding-top:28px}.word{font-size:clamp(4rem,14vw,11rem);line-height:1;font-weight:800;letter-spacing:-.08em;margin-top:35px;color:#f5f8fb}@media(max-width:800px){.foot-grid{grid-template-columns:1fr 1fr;gap:35px}.word{font-size:20vw}}@media(max-width:480px){.foot-grid{grid-template-columns:1fr}.bottom{display:grid;gap:10px}}</style>
